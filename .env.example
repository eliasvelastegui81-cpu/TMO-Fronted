# TODO(sesion-07): en desarrollo, usa http://localhost:8000/api. Al desplegar
# el backend (Railway/Render), reemplaza este valor por la URL pública de tu API.
#
# En producción (GitHub Pages) este valor NO sale de este archivo: lo inyecta
# el workflow de GitHub Actions desde una variable de repositorio (Settings ->
# Secrets and variables -> Actions -> Variables -> VITE_API_URL). Es una
# variable, no un secret: Vite la inserta en el bundle en build-time, así que
# queda visible en el código público — no pongas ahí nada que deba ser secreto.
VITE_API_URL=http://localhost:8000/api
